#!/usr/bin/env bash
# Rewrite the current selection via an LLM on OpenRouter.
# Unlike the offline LanguageTool version, this also fixes awkward phrasing.
# Key: ~/.config/hypr/scripts/.openrouter-key   (chmod 600)

set -euo pipefail

KEYFILE="$HOME/.config/hypr/scripts/.openrouter-key"
PRIMARY="${LLM_MODEL:-anthropic/claude-haiku-5.5}"
FALLBACK="${LLM_FALLBACK:-openai/gpt-oss-20b}"

export YDOTOOL_SOCKET="${YDOTOOL_SOCKET:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/.ydotool_socket}"

notify() { notify-send -a "grammar-llm" -t "${NOTIFY_MS:-12000}" "$1" "${2:-}"; }

[[ -S "$YDOTOOL_SOCKET" ]] || { notify "ydotoold not running" "systemctl --user start ydotool"; exit 1; }
[[ -r "$KEYFILE" ]] || { notify "No OpenRouter key" "Put it in $KEYFILE"; exit 1; }
API_KEY="$(tr -d '[:space:]' <"$KEYFILE")"

# Terminals use Ctrl+Shift+C/V; Ctrl+C there sends SIGINT instead of copying.
# Detect the focused window class and pick the right chord.
TERMINAL_CLASSES="${TERMINAL_CLASSES:-kitty|Alacritty|foot|footclient|org.wezfurlong.wezterm|com.mitchellh.ghostty|org.gnome.Terminal|konsole|xterm|URxvt|st-256color|WezTerm}"

FOCUSED_CLASS="$(hyprctl activewindow -j 2>/dev/null | jq -r '.class // empty' 2>/dev/null || true)"
if [[ -n "$FOCUSED_CLASS" ]] && printf '%s' "$FOCUSED_CLASS" | grep -qiE "^(${TERMINAL_CLASSES})$"; then
    USE_SHIFT=1
else
    USE_SHIFT=0
fi

# 29=ctrl 42=shift 46=c 47=v
do_copy() {
    if [[ $USE_SHIFT -eq 1 ]]; then
        ydotool key --key-delay 12 29:1 42:1 46:1 46:0 42:0 29:0
    else
        ydotool key --key-delay 12 29:1 46:1 46:0 29:0
    fi
}
do_paste() {
    if [[ $USE_SHIFT -eq 1 ]]; then
        ydotool key --key-delay 12 29:1 42:1 47:1 47:0 42:0 29:0
    else
        ydotool key --key-delay 12 29:1 47:1 47:0 29:0
    fi
}

OLD_CLIP="$(wl-paste 2>/dev/null || true)"
restore_clip() { printf '%s' "$OLD_CLIP" | wl-copy 2>/dev/null || true; }

# Sentinel so a failed Ctrl+C cannot silently reuse the old clipboard.
SENTINEL="__grammar_llm_$$__"
printf '%s' "$SENTINEL" | wl-copy
sleep 0.1

TEXT=""
for _ in 1 2 3; do
    do_copy
    sleep 0.3
    CLIP="$(wl-paste 2>/dev/null || true)"
    if [[ -n "$CLIP" && "$CLIP" != "$SENTINEL" ]]; then TEXT="$CLIP"; break; fi
done

if [[ -z "${TEXT//[[:space:]]/}" ]]; then
    notify "Could not copy selection" "Select text first"
    restore_clip
    exit 1
fi

SYSTEM='Correct grammar, spelling, punctuation and collocations. Target an educated native register (C1). Replace calqued or literal expressions with the idiomatic equivalent. Cut redundancy and filler. In English, edit minimally and preserve the author'"'"'s voice; do not vary wording that is already correct. In other languages, restructure freely into natural idiomatic prose.
Reply with only this JSON: {"text":"<corrected text>","note":"<at most 12 words: the one pattern worth learning, or empty if trivial>"}'

ask_model() {
    curl -sS --max-time 45 https://openrouter.ai/api/v1/chat/completions \
        -H "Authorization: Bearer $API_KEY" \
        -H "Content-Type: application/json" \
        -H "HTTP-Referer: https://localhost/grammar-fix" \
        -H "X-Title: grammar-fix" \
        -d "$(jq -n --arg m "$1" --arg s "$SYSTEM" --arg t "$TEXT" '{
              model: $m,
              temperature: 0,
              max_tokens: 2048,
              messages: [{role:"system",content:$s},{role:"user",content:$t}],
              provider: {data_collection: "deny"}
            }')"
}

extract() { jq -er '.choices[0].message.content' <<<"$1" 2>/dev/null; }

# The model is asked for JSON, but may wrap it in a fence or ignore the format.
# Emit "text\x1fnote"; on unparseable output treat the whole reply as the text.
parse_reply() {
    python3 -I -c '
import json, re, sys
raw = sys.stdin.read().strip()
raw = re.sub(r"^```(?:json)?\s*|\s*```$", "", raw).strip()
text, note = raw, ""
try:
    obj = json.loads(raw)
    if isinstance(obj, dict) and "text" in obj:
        text = str(obj["text"])
        note = str(obj.get("note") or "")
except Exception:
    pass
sys.stdout.write(text + "\x1f" + note)
'
}

NOTIFY_MS=2000 notify "Fixing…" ""
RESPONSE="$(ask_model "$PRIMARY" || true)"
MODEL_USED="$PRIMARY"

if ! FIXED="$(extract "$RESPONSE")"; then
    # Free tiers rate-limit; fall back to the cheap paid model.
    RESPONSE="$(ask_model "$FALLBACK" || true)"
    MODEL_USED="$FALLBACK"
    if ! FIXED="$(extract "$RESPONSE")"; then
        ERR="$(jq -r '.error.message // "no response"' <<<"$RESPONSE" 2>/dev/null)"
        notify "LLM failed" "$ERR"
        restore_clip
        exit 1
    fi
fi

PARSED="$(printf '%s' "$FIXED" | parse_reply)"
FIXED="${PARSED%%$'\x1f'*}"
NOTE="${PARSED#*$'\x1f'}"

# Models sometimes wrap the answer in quotes or a code fence despite instructions.
FIXED="$(printf '%s' "$FIXED" | sed -e '1{/^```/d}' -e '${/^```$/d}')"
FIXED="${FIXED#\"}"; FIXED="${FIXED%\"}"
FIXED="$(printf '%s' "$FIXED" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"

if [[ -z "$FIXED" ]]; then
    notify "Empty response" "$MODEL_USED"
    restore_clip
    exit 1
fi

if [[ "$FIXED" == "$TEXT" ]]; then
    notify "No changes needed" ""
    restore_clip
    exit 0
fi

printf '%s' "$FIXED" | wl-copy
sleep 0.25
do_paste
sleep 0.35

restore_clip

# Summarise what changed, word by word, so the correction is visible.
DIFF_OUT="$(python3 -I "$HOME/.config/hypr/scripts/word-diff.py" "$TEXT" "$FIXED" 2>/dev/null || true)"
COUNT="$(sed -n 's/^COUNT=//p' <<<"$DIFF_OUT")"
DETAIL="$(sed -n '2p' <<<"$DIFF_OUT")"

BODY="$DETAIL"
if [[ -n "$NOTE" ]]; then
    BODY="${BODY:+$BODY$'\n'}💡 $NOTE"
fi

if [[ -n "$BODY" ]]; then
    notify "Fixed ${COUNT:-?}" "$BODY"
elif [[ -n "$COUNT" ]]; then
    notify "Fixed ${COUNT} changes" ""
else
    notify "Rewritten" ""
fi
